{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['id','name','age'])",
        "age": {
          ".validate": "newData.isNumber() && newData.val() >= 18 && newData.val() <= 100"
        },
        "coins": {
          ".validate": false
        },
        "vip": {
          ".validate": false
        }
      }
    },
    "messages": {
      "$room": {
        ".read": "auth != null && $room.contains(auth.uid)",
        ".write": "auth != null && $room.contains(auth.uid)"
      }
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "likesLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$day": {
          "$targetId": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "taskClaims": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "adWatchLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "visitsLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$day": {
          "$targetId": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "passportLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$day": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.val() === true"
        }
      }
    },
    "giftsSentLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "spinClaims": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
