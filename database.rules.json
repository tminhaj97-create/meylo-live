{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['id','name','age'])",
        "age": {
          ".validate": "newData.isNumber() && newData.val() >= 18 && newData.val() <= 100"
        },
        "coins": {
          ".validate": false
        },
        "vip": {
          ".validate": false
        },
        "boostedUntil": {
          ".validate": false
        }
      }
    },
    "messages": {
      "$room": {
        ".read": "auth != null && $room.contains(auth.uid)",
        ".write": "auth != null && $room.contains(auth.uid)"
      }
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "likesLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$day": {
          "$targetId": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "taskClaims": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "adWatchLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "visitsLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$day": {
          "$targetId": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "passportLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$day": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.val() === true"
        }
      }
    },
    "giftsSentLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "spinClaims": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$blockedUid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "blockedBy": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$blockerUid": {
          ".write": "auth != null && auth.uid === $blockerUid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "reports": {
      ".read": false,
      "$reportId": {
        ".write": "auth != null && !data.exists() && newData.child('reporterId').val() === auth.uid",
        ".validate": "newData.hasChildren(['reporterId','reportedId','reason','timestamp'])"
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        ".write": "auth != null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid || (!data.exists() && newData.child('callerId').val() === auth.uid))"
      }
    },
    "incomingCalls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".write": "auth != null && (auth.uid === $uid || (newData.exists() && newData.child('callerId').val() === auth.uid))"
        }
      }
    },
    "orders": {
      ".read": false,
      ".write": false
    }
  }
}
